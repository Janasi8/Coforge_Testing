import random
import re

from playwright.sync_api import Page

from utils.config import CATEGORY_NAMES, HOME_URL


class HomePage:

    def __init__(self, page: Page):
        self.page = page

    # ============================================================
    # OPEN HOME PAGE
    # ============================================================

    def open(self) -> None:

        self.page.goto(
            HOME_URL,
            wait_until="domcontentloaded"
        )

        self.page.wait_for_timeout(1000)

    # ============================================================
    # ACCEPT COOKIES
    # ============================================================

    def accept_cookies_if_present(self) -> None:

        print(
            "Checking cookie popup..."
        )

        try:

            self.page.wait_for_timeout(1500)

            cookie_button = self.page.locator(
                "#onetrust-banner-sdk button"
            ).filter(
                has_text=re.compile(
                    r"yes\s*i\s*accept",
                    re.I
                )
            )

            for i in range(
                cookie_button.count()
            ):

                button = cookie_button.nth(i)

                try:

                    if button.is_visible(
                        timeout=2000
                    ):

                        print(
                            "Cookie popup found."
                        )

                        button.click(
                            force=True
                        )

                        print(
                            "Cookies Accepted"
                        )

                        self.page.wait_for_timeout(
                            1000
                        )

                        return

                except Exception:
                    continue

            print(
                "No cookie popup. Continuing..."
            )

        except Exception:

            print(
                "No cookie popup. Continuing..."
            )

    # ============================================================
    # CATEGORY LOCATOR
    # ============================================================

    def _category_locator(
        self,
        name: str
    ):

        return self.page.get_by_role(
            "link",
            name=re.compile(
                rf"^{re.escape(name)}$",
                re.I
            )
        )

    # ============================================================
    # RANDOM CATEGORY
    # ============================================================

    def select_random_category(self) -> str:

        visible_categories = []

        for name in CATEGORY_NAMES:

            locator = self._category_locator(
                name
            )

            for i in range(
                locator.count()
            ):

                element = locator.nth(i)

                try:

                    if element.is_visible(
                        timeout=700
                    ):

                        visible_categories.append(
                            (name, element)
                        )

                        break

                except Exception:
                    continue

        if not visible_categories:

            raise AssertionError(
                "No visible shopping categories found."
            )

        selected_name, selected_element = (
            random.choice(
                visible_categories
            )
        )

        print(
            f"Visible categories found: "
            f"{len(visible_categories)}"
        )

        print(
            f"Random category selected: "
            f"{selected_name}"
        )

        selected_element.scroll_into_view_if_needed()

        selected_element.click(
            force=True
        )

        self.page.wait_for_timeout(
            2000
        )

        print(
            f"Successfully opened category: "
            f"{selected_name}"
        )

        return selected_name

    # ============================================================
    # CLOSE BASKET POPUP
    # ============================================================

    def close_basket_popup(self) -> None:

        # Exact XPath provided by you
        close_button = self.page.locator(
            "xpath=//*[@id='__next']/main/div[1]/div/div[2]/div/div/div[5]/button"
        )

        try:

            if close_button.is_visible(
                timeout=3000
            ):

                print(
                    "Basket popup found."
                )

                close_button.click(
                    force=True
                )

                print(
                    "Basket popup closed."
                )

                self.page.wait_for_timeout(
                    700
                )

                return

        except Exception:
            pass

        # --------------------------------------------------------
        # Fallback: Continue Shopping
        # --------------------------------------------------------

        continue_shopping = self.page.get_by_role(
            "button",
            name=re.compile(
                r"continue\s*shopping",
                re.I
            )
        )

        try:

            if continue_shopping.is_visible(
                timeout=1500
            ):

                continue_shopping.click(
                    force=True
                )

                print(
                    "Continue shopping clicked."
                )

                self.page.wait_for_timeout(
                    700
                )

        except Exception:
            pass

    # ============================================================
    # GET VISIBLE ADD TO BASKET BUTTONS
    # ============================================================

    def _get_visible_basket_buttons(self):

        buttons = self.page.get_by_role(
            "button",
            name=re.compile(
                r"add\s*to\s*basket",
                re.I
            )
        )

        visible_buttons = []

        for i in range(
            buttons.count()
        ):

            button = buttons.nth(i)

            try:

                if not button.is_visible(
                    timeout=500
                ):
                    continue

                if not button.is_enabled():
                    continue

                box = button.bounding_box()

                if box is None:
                    continue

                visible_buttons.append(
                    button
                )

            except Exception:
                continue

        return visible_buttons

    # ============================================================
    # ADD ONE RANDOM PRODUCT
    # ============================================================

    def add_random_product_to_basket(
        self
    ) -> bool:

        print(
            "Looking for random Add to Basket product..."
        )

        # --------------------------------------------------------
        # First search currently visible buttons
        # --------------------------------------------------------

        visible_buttons = (
            self._get_visible_basket_buttons()
        )

        # --------------------------------------------------------
        # If none found, scroll
        # --------------------------------------------------------

        if not visible_buttons:

            print(
                "No Add to Basket button currently visible. "
                "Scrolling..."
            )

            for _ in range(8):

                self.page.mouse.wheel(
                    0,
                    600
                )

                self.page.wait_for_timeout(
                    700
                )

                visible_buttons = (
                    self._get_visible_basket_buttons()
                )

                if visible_buttons:
                    break

        if not visible_buttons:

            raise AssertionError(
                "No visible Add to Basket buttons found."
            )

        # --------------------------------------------------------
        # Random product
        # --------------------------------------------------------

        selected_index = random.randrange(
            len(visible_buttons)
        )

        selected_button = (
            visible_buttons[selected_index]
        )

        print(
            f"Currently visible Add to Basket "
            f"buttons: {len(visible_buttons)}"
        )

        print(
            f"Random product selected: "
            f"button #{selected_index + 1}"
        )

        # --------------------------------------------------------
        # Scroll to product
        # --------------------------------------------------------

        selected_button.scroll_into_view_if_needed()

        self.page.wait_for_timeout(
            500
        )

        # --------------------------------------------------------
        # Click Add to Basket
        # --------------------------------------------------------

        selected_button.click(
            force=True
        )

        print(
            "Product added to basket."
        )

        # --------------------------------------------------------
        # IMPORTANT:
        # Close basket popup immediately
        # --------------------------------------------------------

        self.close_basket_popup()

        return True

    # ============================================================
    # ADD MULTIPLE RANDOM PRODUCTS
    # ============================================================

    def add_multiple_random_products(
        self,
        min_products: int = 2,
        max_products: int = 4
    ) -> int:

        number_of_products = random.randint(
            min_products,
            max_products
        )

        print(
            f"Random number of products to add: "
            f"{number_of_products}"
        )

        products_added = 0

        for product_number in range(
            number_of_products
        ):

            print(
                "\n" + "-" * 50
            )

            print(
                f"Adding random product "
                f"{product_number + 1} "
                f"of {number_of_products}"
            )

            try:

                success = (
                    self.add_random_product_to_basket()
                )

                if success:

                    products_added += 1

            except Exception as e:

                print(
                    f"Product "
                    f"{product_number + 1} "
                    f"could not be added: "
                    f"{type(e).__name__}"
                )

                # Try closing popup before next attempt
                self.close_basket_popup()

                # Continue instead of immediately failing
                continue

        print(
            "\n" + "-" * 50
        )

        print(
            f"Total random products added: "
            f"{products_added}"
        )

        return products_added
