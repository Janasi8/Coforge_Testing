import re

from playwright.sync_api import Page
from utils.config import HOME_URL


class AccountPage:

    def __init__(self, page: Page):
        self.page = page

    # ============================================================
    # OPEN MY ACCOUNT
    # ============================================================

    def open_my_account(self) -> None:

        print("Looking for My H&B profile...")

        # --------------------------------------------------------
        # STEP 1: Click the profile / My H&B area
        # --------------------------------------------------------

        profile_clicked = False

        profile_locators = [

            # My H&B text
            self.page.get_by_text(
                "My H&B",
                exact=True
            ),

            # Profile button / area
            self.page.get_by_role(
                "button",
                name=re.compile(
                    r"my h&b|account|profile",
                    re.I
                )
            ),

            # Generic element containing My H&B
            self.page.locator(
                "text=My H&B"
            )
        ]

        for locator in profile_locators:

            try:

                count = locator.count()

                if count == 0:
                    continue

                for i in range(count):

                    element = locator.nth(i)

                    try:

                        if element.is_visible(timeout=2000):

                            print(
                                "My H&B profile found."
                            )

                            element.scroll_into_view_if_needed()

                            self.page.wait_for_timeout(500)

                            element.click(
                                force=True
                            )

                            print(
                                "My H&B profile clicked."
                            )

                            profile_clicked = True

                            break

                    except Exception:
                        continue

                if profile_clicked:
                    break

            except Exception:
                continue

        if not profile_clicked:

            raise AssertionError(
                "Could not find My H&B profile."
            )

        # --------------------------------------------------------
        # Wait for dropdown
        # --------------------------------------------------------

        self.page.wait_for_timeout(1000)

        # --------------------------------------------------------
        # STEP 2: Click My Account from dropdown
        # --------------------------------------------------------

        print(
            "Looking for My Account in profile dropdown..."
        )

        my_account = self.page.locator(
            "a[href*='/my-account']"
        )

        clicked = False

        if my_account.count() > 0:

            for i in range(my_account.count()):

                element = my_account.nth(i)

                try:

                    if element.is_visible(
                        timeout=2000
                    ):

                        print(
                            "My Account option found."
                        )

                        element.scroll_into_view_if_needed()

                        self.page.wait_for_timeout(300)

                        element.click(
                            force=True
                        )

                        clicked = True

                        print(
                            "My Account clicked."
                        )

                        break

                except Exception:
                    continue

        # --------------------------------------------------------
        # Fallback: text My Account
        # --------------------------------------------------------

        if not clicked:

            my_account = self.page.get_by_text(
                "My Account",
                exact=True
            )

            for i in range(my_account.count()):

                element = my_account.nth(i)

                try:

                    if element.is_visible(
                        timeout=2000
                    ):

                        print(
                            "My Account option found."
                        )

                        element.scroll_into_view_if_needed()

                        element.click(
                            force=True
                        )

                        clicked = True

                        print(
                            "My Account clicked."
                        )

                        break

                except Exception:
                    continue

        # --------------------------------------------------------
        # If click did not work, open account URL directly
        # --------------------------------------------------------

        if not clicked:

            print(
                "My Account click was not successful."
            )

            print(
                "Opening My Account page directly..."
            )

            self.page.goto(
                "https://www.hollandandbarrett.com/my-account/overview",
                wait_until="domcontentloaded"
            )

        # --------------------------------------------------------
        # Wait for account page
        # --------------------------------------------------------

        try:

            self.page.wait_for_url(
                "**/my-account/**",
                timeout=15000
            )

        except Exception:

            # Sometimes website changes URL slowly.
            # Direct navigation is used as final fallback.

            if "/my-account/" not in self.page.url:

                print(
                    "Account URL was not detected."
                )

                self.page.goto(
                    "https://www.hollandandbarrett.com/my-account/overview",
                    wait_until="domcontentloaded"
                )

        self.page.wait_for_timeout(1500)

        print(
            f"Current URL: {self.page.url}"
        )

        print(
            "My Account opened successfully."
        )

    # ============================================================
    # LOGOUT
    # ============================================================

    def logout(self) -> None:

        print(
            "Looking for Sign out..."
        )

        # --------------------------------------------------------
        # The H&B account page has a visible "Sign out" button.
        # Scroll through the page until it becomes visible.
        # --------------------------------------------------------

        sign_out = self.page.get_by_text(
            "Sign out",
            exact=True
        )

        # --------------------------------------------------------
        # Try exact text first
        # --------------------------------------------------------

        for i in range(sign_out.count()):

            element = sign_out.nth(i)

            try:

                if element.is_visible(
                    timeout=2000
                ):

                    print(
                        "Sign out found."
                    )

                    element.scroll_into_view_if_needed()

                    self.page.wait_for_timeout(500)

                    element.click(
                        force=True
                    )

                    print(
                        "Sign out clicked."
                    )

                    return

            except Exception:
                continue

        # --------------------------------------------------------
        # Scroll down and search again
        # --------------------------------------------------------

        print(
            "Sign out not visible yet. Scrolling..."
        )

        for _ in range(8):

            self.page.mouse.wheel(
                0,
                700
            )

            self.page.wait_for_timeout(700)

            sign_out = self.page.get_by_text(
                "Sign out",
                exact=True
            )

            for i in range(sign_out.count()):

                element = sign_out.nth(i)

                try:

                    if element.is_visible(
                        timeout=1000
                    ):

                        print(
                            "Sign out found after scrolling."
                        )

                        element.scroll_into_view_if_needed()

                        self.page.wait_for_timeout(300)

                        element.click(
                            force=True
                        )

                        print(
                            "Sign out clicked."
                        )

                        return

                except Exception:
                    continue

        # --------------------------------------------------------
        # Button fallback
        # --------------------------------------------------------

        sign_out_button = self.page.get_by_role(
            "button",
            name=re.compile(
                r"sign\s*out|logout|log\s*out",
                re.I
            )
        )

        for i in range(
            sign_out_button.count()
        ):

            button = sign_out_button.nth(i)

            try:

                if button.is_visible(
                    timeout=1500
                ):

                    print(
                        "Sign out button found."
                    )

                    button.scroll_into_view_if_needed()

                    button.click(
                        force=True
                    )

                    print(
                        "Sign out button clicked."
                    )

                    return

            except Exception:
                continue

        # --------------------------------------------------------
        # Original Java locator fallback
        # --------------------------------------------------------

        original_logout = self.page.locator(
            "button.jsx-4006266799.secondary.size-m.with-icon"
        )

        for i in range(
            original_logout.count()
        ):

            button = original_logout.nth(i)

            try:

                if button.is_visible(
                    timeout=1000
                ):

                    print(
                        "Original Java logout locator found."
                    )

                    button.scroll_into_view_if_needed()

                    button.click(
                        force=True
                    )

                    print(
                        "Logout clicked."
                    )

                    return

            except Exception:
                continue

        raise AssertionError(
            "Sign out / Logout button was not found."
        )

    # ============================================================
    # VERIFY LOGOUT
    # ============================================================

    def verify_logout(self) -> None:

        print(
            "Verifying logout..."
        )

        try:

            self.page.wait_for_url(
                "**hollandandbarrett.com/**",
                timeout=20000
            )

        except Exception:
            pass

        current_url = self.page.url.rstrip("/")

        expected_url = HOME_URL.rstrip("/")

        print(
            f"Current URL after logout: "
            f"{self.page.url}"
        )

        # --------------------------------------------------------
        # Logout may redirect to home page.
        # --------------------------------------------------------

        if current_url == expected_url:

            print(
                "Logout Successful"
            )

            return

        # --------------------------------------------------------
        # Sometimes H&B redirects to another public page.
        # Make sure we are no longer inside account.
        # --------------------------------------------------------

        if "/my-account" not in current_url.lower():

            print(
                "Logout Successful"
            )

            return

        raise AssertionError(
            "Logout was not successful. "
            f"Current URL: {self.page.url}"
        )
