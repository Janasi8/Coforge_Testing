import os

from pages.login_page import LoginPage
from pages.home_page import HomePage
from pages.account_page import AccountPage


def run_user_test(
    browser,
    email,
    password,
    user_name
):

    print("\n" + "=" * 70)
    print(
        f"STARTING TEST FOR {user_name}"
    )
    print("=" * 70)

    # Separate browser context for each user
    context = browser.new_context(
        viewport={
            "width": 1440,
            "height": 900
        },
        locale="en-GB"
    )

    page = context.new_page()

    page.set_default_timeout(15000)

    try:

        login_page = LoginPage(page)
        home_page = HomePage(page)
        account_page = AccountPage(page)

        # ========================================================
        # LOGIN
        # ========================================================

        print(
            f"{user_name}: Opening Login Page"
        )

        login_page.open()

        print(
            f"{user_name}: Logging in..."
        )

        login_page.login(
            email,
            password
        )

        login_page.verify_login()

        print(
            f"{user_name}: Login Successful"
        )

        # ========================================================
        # OPEN HOME PAGE
        # ========================================================

        print(
            f"{user_name}: Opening Home Page"
        )

        home_page.open()

        # ========================================================
        # ACCEPT COOKIES
        # ========================================================

        home_page.accept_cookies_if_present()

        # ========================================================
        # RANDOM CATEGORY
        # ========================================================

        selected_category = (
            home_page.select_random_category()
        )

        # ========================================================
        # RANDOM MULTIPLE PRODUCTS
        # ========================================================

        products_added = (
            home_page.add_multiple_random_products(
                min_products=2,
                max_products=4
            )
        )

        if products_added == 0:

            raise AssertionError(
                f"{user_name}: "
                "No products were added."
            )

        print(
            f"{user_name}: "
            f"Category = {selected_category}"
        )

        print(
            f"{user_name}: "
            f"Products Added = "
            f"{products_added}"
        )

        # ========================================================
        # MY ACCOUNT
        # ========================================================

        print(
            f"{user_name}: Opening My Account"
        )

        account_page.open_my_account()

        # ========================================================
        # LOGOUT
        # ========================================================

        print(
            f"{user_name}: Logging out"
        )

        account_page.logout()

        account_page.verify_logout()

        print(
            f"{user_name}: Logout Successful"
        )

    finally:

        context.close()

        print(
            f"{user_name}: Browser context closed"
        )


# =================================================================
# MULTIPLE USERS
# =================================================================

def test_multiple_users_random_products(
    browser
):

    # =============================================================
    # USER 1
    # =============================================================

    user1_email = os.getenv(
        "HB_EMAIL",
        ""
    )

    user1_password = os.getenv(
        "HB_PASSWORD",
        ""
    )

    # =============================================================
    # USER 2
    # =============================================================

    user2_email = os.getenv(
        "HB_USER2_EMAIL",
        ""
    )

    user2_password = os.getenv(
        "HB_USER2_PASSWORD",
        ""
    )

    # =============================================================
    # VALIDATE CREDENTIALS
    # =============================================================

    if not user1_email or not user1_password:

        raise ValueError(
            "HB_EMAIL and HB_PASSWORD "
            "are required in .env"
        )

    if not user2_email or not user2_password:

        raise ValueError(
            "HB_USER2_EMAIL and "
            "HB_USER2_PASSWORD "
            "are required in .env"
        )

    # =============================================================
    # USER 1
    # =============================================================

    run_user_test(
        browser,
        user1_email,
        user1_password,
        "User 1"
    )

    # =============================================================
    # USER 2
    # =============================================================

    run_user_test(
        browser,
        user2_email,
        user2_password,
        "User 2"
    )
