import re
from playwright.sync_api import Page
from utils.config import HOME_URL


class AccountPage:

    def __init__(self, page: Page):
        self.page = page

    # ============================================================
    # OPEN MY ACCOUNT
    # ============================================================

    def open_my_account(self) -> None:

        print("Looking for profile icon...")

        clicked = False

        # --------------------------------------------------------
        # STEP 1: Look for profile/account type elements
        # without depending on user's name
        # --------------------------------------------------------

        profile_candidates = self.page.locator(
            "[aria-label]"
        )

        for i in range(profile_candidates.count()):

            element = profile_candidates.nth(i)

            try:

                if not element.is_visible(timeout=800):
                    continue

                aria_label = element.get_attribute(
                    "aria-label"
                )

                if not aria_label:
                    continue

                label = aria_label.strip().lower()

                # Ignore common non-profile elements
                ignored_labels = [
                    "menu",
                    "search",
                    "cart",
                    "basket",
                    "close",
                    "feedback",
                    "navigation",
                    "home",
                ]

                if label in ignored_labels:
                    continue

                # Profile icon is normally near the top
                box = element.bounding_box()

                if box is None:
                    continue

                if box["y"] > 250:
                    continue

                print(
                    f"Possible profile element found: "
                    f"{aria_label}"
                )

                element.scroll_into_view_if_needed()

                self.page.wait_for_timeout(500)

                element.click(force=True)

                self.page.wait_for_timeout(1000)

                # Check whether My Account page opened
                if "/my-account/" in self.page.url.lower():

                    print("Profile icon clicked.")
                    print("My Account page opened.")

                    clicked = True
                    break

            except Exception:
                continue

        # --------------------------------------------------------
        # STEP 2: Try common profile/account selectors
        # --------------------------------------------------------

        if not clicked:

            fallback_selectors = [

                "[aria-label*='account' i]",

                "[aria-label*='profile' i]",

                "[title*='account' i]",

                "[title*='profile' i]",

            ]

            for selector in fallback_selectors:

                try:

                    elements = self.page.locator(
                        selector
                    )

                    for i in range(elements.count()):

                        element = elements.nth(i)

                        try:

                            if not element.is_visible(
                                timeout=1000
                            ):
                                continue

                            print(
                                f"Trying profile selector: "
                                f"{selector}"
                            )

                            element.scroll_into_view_if_needed()

                            element.click(
                                force=True
                            )

                            self.page.wait_for_timeout(
                                1000
                            )

                            if "/my-account/" in (
                                self.page.url.lower()
                            ):

                                print(
                                    "Profile icon clicked."
                                )

                                print(
                                    "My Account page opened."
                                )

                                clicked = True
                                break

                        except Exception:
                            continue

                    if clicked:
                        break

                except Exception:
                    continue

        # --------------------------------------------------------
        # STEP 3: Direct navigation fallback
        # --------------------------------------------------------

        if not clicked:

            print(
                "Profile icon could not be clicked."
            )

            print(
                "Opening My Account directly..."
            )

            self.page.goto(
                "https://www.hollandandbarrett.com/"
                "my-account/overview",
                wait_until="domcontentloaded"
            )

            if "/my-account/" in self.page.url.lower():

                print(
                    "My Account page opened directly."
                )

                clicked = True

        if not clicked:

            raise AssertionError(
                "Could not open My Account."
            )

    # ============================================================
    # LOGOUT
    # ============================================================

    def logout(self) -> None:

        print("Looking for Sign out...")

        # --------------------------------------------------------
        # STEP 1: Exact Sign out button
        # --------------------------------------------------------

        sign_out = self.page.get_by_role(
            "button",
            name="Sign out",
            exact=True
        )

        clicked = False

        for i in range(sign_out.count()):

            element = sign_out.nth(i)

            try:

                if not element.is_visible(
                    timeout=2000
                ):
                    continue

                print("Sign out button found.")

                element.scroll_into_view_if_needed()

                self.page.wait_for_timeout(1000)

                element.click(
                    force=True
                )

                print("Sign out clicked.")

                clicked = True

                break

            except Exception:
                continue

        # --------------------------------------------------------
        # STEP 2: Text fallback
        # --------------------------------------------------------

        if not clicked:

            sign_out = self.page.get_by_text(
                "Sign out",
                exact=True
            )

            for i in range(sign_out.count()):

                element = sign_out.nth(i)

                try:

                    if not element.is_visible(
                        timeout=2000
                    ):
                        continue

                    print(
                        "Sign out text found."
                    )

                    element.scroll_into_view_if_needed()

                    self.page.wait_for_timeout(1000)

                    element.click(
                        force=True
                    )

                    print(
                        "Sign out clicked."
                    )

                    clicked = True

                    break

                except Exception:
                    continue

        # --------------------------------------------------------
        # STEP 3: Original Java locator fallback
        # --------------------------------------------------------

        if not clicked:

            original_logout = self.page.locator(
                "button.jsx-4006266799."
                "secondary.size-m.with-icon"
            )

            for i in range(
                original_logout.count()
            ):

                element = original_logout.nth(i)

                try:

                    if not element.is_visible(
                        timeout=1000
                    ):
                        continue

                    print(
                        "Sign out found using "
                        "original locator."
                    )

                    element.scroll_into_view_if_needed()

                    element.click(
                        force=True
                    )

                    print(
                        "Sign out clicked."
                    )

                    clicked = True

                    break

                except Exception:
                    continue

        # --------------------------------------------------------
        # STEP 4: Last fallback - scan buttons
        # --------------------------------------------------------

        if not clicked:

            all_buttons = self.page.locator(
                "button"
            )

            for i in range(
                all_buttons.count()
            ):

                element = all_buttons.nth(i)

                try:

                    if not element.is_visible(
                        timeout=500
                    ):
                        continue

                    text = element.inner_text(
                        timeout=1000
                    ).strip()

                    if re.search(
                        r"sign\s*out|logout|log\s*out",
                        text,
                        re.I
                    ):

                        print(
                            f"Logout button found: "
                            f"{text}"
                        )

                        element.scroll_into_view_if_needed()

                        element.click(
                            force=True
                        )

                        print(
                            "Sign out clicked."
                        )

                        clicked = True

                        break

                except Exception:
                    continue

        if not clicked:

            raise AssertionError(
                "Sign out / Logout button "
                "was not found."
            )

    # ============================================================
    # VERIFY LOGOUT
    # ============================================================

    def verify_logout(self) -> None:

        print("Verifying logout...")

        # Wait for navigation after sign out
        self.page.wait_for_timeout(2000)

        # Give the website time to finish logout
        try:

            self.page.wait_for_url(
                "**hollandandbarrett.com/**",
                timeout=15000
            )

        except Exception:
            pass

        current_url = self.page.url.lower()

        print(
            f"Current URL after logout: "
            f"{self.page.url}"
        )

        # Logout can land on homepage or another
        # Holland & Barrett public page.
        assert (
            "hollandandbarrett.com" in current_url
        ), (
            "Logout verification failed. "
            f"Current URL: {self.page.url}"
        )

        # Make sure we are not still on My Account
        assert (
            "/my-account/" not in current_url
        ), (
            "User still appears to be logged in. "
            f"Current URL: {self.page.url}"
        )

        print("Logout Successful")
