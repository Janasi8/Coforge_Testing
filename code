import re
from playwright.sync_api import Page
from utils.config import HOME_URL


class AccountPage:

    def __init__(self, page: Page):
        self.page = page

    # ============================================================
    # OPEN MY ACCOUNT
    # ============================================================

    def open_my_account(self) -> None:

        print("Looking for profile icon...")

        # J / Profile icon
        profile = self.page.locator(
            "div[aria-label='Janasi']"
        )

        if profile.count() == 0:
            raise AssertionError(
                "Could not find profile icon."
            )

        profile_clicked = False

        for i in range(profile.count()):

            element = profile.nth(i)

            try:
                if element.is_visible(timeout=2000):

                    print("Profile icon found.")

                    element.scroll_into_view_if_needed()

                    self.page.wait_for_timeout(500)

                    element.click(force=True)

                    print("Profile dropdown opened.")

                    profile_clicked = True
                    break

            except Exception:
                continue

        if not profile_clicked:
            raise AssertionError(
                "Could not click profile icon."
            )

        # Give dropdown time to appear
        self.page.wait_for_timeout(1000)

        # ========================================================
        # CLICK MY ACCOUNT FROM DROPDOWN
        # ========================================================

        print("Looking for My Account option...")

        my_account = self.page.get_by_text(
            "My Account",
            exact=True
        )

        if my_account.count() == 0:

            # Fallback using href
            my_account = self.page.locator(
                "a[href*='/my-account/']"
            )

        if my_account.count() == 0:
            raise AssertionError(
                "My Account option was not found."
            )

        account_clicked = False

        for i in range(my_account.count()):

            element = my_account.nth(i)

            try:

                if element.is_visible(timeout=2000):

                    print("My Account option found.")

                    element.scroll_into_view_if_needed()

                    self.page.wait_for_timeout(500)

                    element.click(force=True)

                    print("My Account clicked.")

                    account_clicked = True

                    break

            except Exception:
                continue

        if not account_clicked:
            raise AssertionError(
                "Could not click My Account."
            )

        # Wait for My Account page
        self.page.wait_for_url(
            "**/my-account/overview",
            timeout=15000
        )

        print("My Account page opened.")

    # ============================================================
    # LOGOUT
    # ============================================================

    def logout(self) -> None:

        print("Looking for profile icon for logout...")

        # After opening My Account, click profile again
        # to open the dropdown containing Sign out.
        profile = self.page.locator(
            "div[aria-label='Janasi']"
        )

        if profile.count() == 0:
            raise AssertionError(
                "Could not find profile icon for logout."
            )

        profile_clicked = False

        for i in range(profile.count()):

            element = profile.nth(i)

            try:

                if element.is_visible(timeout=2000):

                    element.scroll_into_view_if_needed()

                    self.page.wait_for_timeout(500)

                    element.click(force=True)

                    print(
                        "Profile dropdown opened for logout."
                    )

                    profile_clicked = True

                    break

            except Exception:
                continue

        if not profile_clicked:
            raise AssertionError(
                "Could not click profile icon for logout."
            )

        # Give dropdown time to appear
        self.page.wait_for_timeout(1000)

        # ========================================================
        # CLICK SIGN OUT
        # ========================================================

        print("Looking for Sign out...")

        sign_out = self.page.get_by_text(
            "Sign out",
            exact=True
        )

        if sign_out.count() == 0:

            # Fallback
            sign_out = self.page.get_by_role(
                "button",
                name=re.compile(
                    r"sign\s*out",
                    re.I
                )
            )

        if sign_out.count() == 0:
            raise AssertionError(
                "Sign out option was not found."
            )

        logout_clicked = False

        for i in range(sign_out.count()):

            element = sign_out.nth(i)

            try:

                if element.is_visible(timeout=2000):

                    print("Sign out found.")

                    element.scroll_into_view_if_needed()

                    self.page.wait_for_timeout(500)

                    element.click(force=True)

                    print("Sign out clicked.")

                    logout_clicked = True

                    break

            except Exception:
                continue

        if not logout_clicked:
            raise AssertionError(
                "Could not click Sign out."
            )

    # ============================================================
    # VERIFY LOGOUT
    # ============================================================

    def verify_logout(self) -> None:

        print("Verifying logout...")

        self.page.wait_for_url(
            "**hollandandbarrett.com/**",
            timeout=20000
        )

        current_url = self.page.url.rstrip("/")
        expected_url = HOME_URL.rstrip("/")

        print(
            f"Current URL after logout: "
            f"{self.page.url}"
        )

        assert current_url == expected_url, (
            f"Unexpected URL after logout: "
            f"{self.page.url}"
        )

        print("Logout Successful")
